# Copy to .env.local and adjust. Every VITE_* value is compiled into the public JS
# bundle, so never put secrets here.

# Display name used in the title bar and emails previews
VITE_APP_NAME=Servio Console

# true  = in-memory mock backend with realistic demo data (persisted in localStorage)
# false = real REST API through src/services/http.ts (see docs/BACKEND_INTEGRATION.md)
VITE_USE_MOCKS=true
VITE_API_URL=https://api.servio.app/v1/admin
VITE_REQUEST_TIMEOUT_MS=20000

# Artificial latency (ms) for mock calls so loading states are visible. 0 disables it.
VITE_MOCK_LATENCY=350

# Persist mock data between reloads (localStorage). false = reset on every reload.
VITE_MOCK_PERSIST=true

# Dev only: show the TanStack Query devtools button
VITE_QUERY_DEVTOOLS=false
